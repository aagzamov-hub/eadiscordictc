# ---- Discord (Developer Portal → your app) ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: comma-separated server IDs the bot may act in. Recommended.
DISCORD_GUILD_IDS=

# ---- Database (any Postgres 13+) ----
DATABASE_URL=postgres://user:pass@host:5432/db
DATABASE_SSL=false

# ---- MCP endpoint ----
PORT=3000
# Long random secret. Generate: openssl rand -hex 32
MCP_API_KEY=
# Delete / kick / ban / delete channel wait for approve_action
REQUIRE_APPROVAL=true
DEFAULT_TIMEZONE=America/Toronto

# ---- AI triage (off until you have a test server set up) ----
TRIAGE_ENABLED=false
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-4-5-20251001
TRIAGE_MIN_CHARS=15
# Alerts go here when a message's cohort has no alert channel of its own
FACILITATOR_ALERT_CHANNEL_ID=

# ---- Wrike tickets (check with your Wrike admin before enabling) ----
WRIKE_ENABLED=false
# Wrike → Apps & Integrations → API → create app → Permanent access token
WRIKE_ACCESS_TOKEN=
# Your data centre's host (www.wrike.com, app-us2.wrike.com, app-eu.wrike.com)
WRIKE_API_HOST=www.wrike.com
