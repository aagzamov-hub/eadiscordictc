{
  "name": "ea-discord-connector",
  "version": "0.1.0",
  "description": "Discord management bot + MCP connector with scheduling and AI triage",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/db/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "invite": "tsx scripts/invite-url.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aagzamov-hub/eadiscordictc.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/aagzamov-hub/eadiscordictc/issues"
  },
  "homepage": "https://github.com/aagzamov-hub/eadiscordictc#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "cron-parser": "^5.10.1",
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
